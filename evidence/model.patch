+	}
+	type joined interface{ Unwrap() []error }
+	if j, ok := err.(joined); ok {
+		n := 0
+		for _, e := range j.Unwrap() {
+			if e != nil {
+				n++
+			}
+		}
+		if n > 0 {
+			return n
+		}
+	}
+	return 1
+}
