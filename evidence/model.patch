+func TestPersistentCache_CrossInstanceReuse(t *testing.T) {
+	t.Parallel()
+	cachePath := filepath.Join(t.TempDir(), "verdicts.json")
+	cfg := testVerdictConfig()
+
+	gopath1 := writeFixture(t, fixtureSrcV1)
