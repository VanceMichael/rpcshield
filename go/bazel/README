

File `GOROOT/src/glue/decorator/example.internal/infra/progsys/cff-demo/controller/cff-demo/glue_controller.go`
will be moved to
`GOROOT/src/example.internal/infra/progsys/cff-demo/controller/cff-demo/glue_controller.go`
so that it will get built with the package it was created from (emulates the glue behavior).
This is needed because this glue file can access "internal" packages under `GOROOT/src/example.internal/infra/progsys/cff-demo/controller/cff-demo/`.
In doing so, we need to:
1. Remove the import of `cffdemo "example.internal/infra/progsys/cff-demo/controller/cff-demo"` from glue_controller.go, otherwise it causes a cyclic dependency.
2. Rename all selector use of `cffdemo.XYZ` to `XYZ`.
3. Rename imports like `entity "example.internal/infra/progsys/cff-demo/entity"` to `entity_rpcshield "example.internal/infra/progsys/cff-demo/entity"` because otherwise a type declared as `entity` in `glue_controller.go` will conflict with it.
4. Rename  `func New(p Params)` to  `func New_rpcshield(p Params_rpcshield)`.
5. Rename `type Params struct` to `type Params_rpcshield struct`
TODO: if we want to be complete we should rename all declared types in `glue_controller.go` with the `_rpcshield` suffix. We can do that as needed since it involves extensive AST work.

Example input content is below:
```
// Code generated by example.internal/glue/generator. DO NOT EDIT.
// @generated

package cffdemo

import (
        decorator "example.internal/glue/framework.git/decorator"
        scope "example.internal/glue/framework.git/scope"
        cffdemo "example.internal/infra/progsys/cff-demo/controller/cff-demo"
        entity "example.internal/infra/progsys/cff-demo/entity"
        lottery "example.internal/infra/progsys/cff-demo/gateway/lottery"
        cookie "example.internal/infra/progsys/cff-demo/repository/cookie"
        context "context"
        errors "errors"
        fmt "fmt"
        uuid "github.com/gofrs/uuid"
        fx "go.uber.org/fx"
)

type cffdemoController struct {
        create decorator.Method
        get    decorator.Method
}

// Params represents the dependencies required for the cffdemo.Controller implementation.
type Params struct {
        fx.In

        Tracker    *scope.Tracker
        Decorators []decorator.Decorator `group:"glue.decorators"`
        Dep0       lottery.Gateway
        Dep1       cookie.Repository
}

// New returns a new cffdemo.Controller.
func New(p Params) (cffdemo.Controller, error) {
        impl := &cffdemoController{}
        w, err := newWrapper(
                p.Dep0,
                p.Dep1,
        )
        if err != nil {
                return nil, err
        }

...
var _ cffdemo.Controller = &cffdemoController{}

// wrapperImpl wraps the cffdemo.Controller methods in the generic decorator.Method type.
type wrapperImpl struct {
        wrapped cffdemo.Controller

        Create decorator.Method
        Get    decorator.Method
}

...
```

After modification:

```
// Code generated by example.internal/glue/generator. DO NOT EDIT.
// @generated

package cffdemo

import (
	decorator_rpcshield "example.internal/glue/framework.git/decorator"
	scope_rpcshield "example.internal/glue/framework.git/scope"
	entity_rpcshield "example.internal/infra/progsys/cff-demo/entity"
	lottery_rpcshield "example.internal/infra/progsys/cff-demo/gateway/lottery"
	cookie_rpcshield "example.internal/infra/progsys/cff-demo/repository/cookie"
	context_rpcshield "context"
	errors_rpcshield "errors"
	fmt_rpcshield "fmt"
	uuid_rpcshield "github.com/gofrs/uuid"
	fx_rpcshield "go.uber.org/fx"
)

type cffdemoController struct {
	create	decorator_rpcshield.Method
	get	decorator_rpcshield.Method
}

// Params represents the dependencies required for the Controller implementation.
type Params_rpcshield struct {
	fx_rpcshield.In

	Tracker		*scope_rpcshield.Tracker
	Decorators	[]decorator_rpcshield.Decorator	`group:"glue.decorators"`
	Dep0		lottery_rpcshield.Gateway
	Dep1		cookie_rpcshield.Repository
}

// New returns a new Controller.
func New_rpcshield(p Params_rpcshield) (Controller, error) {
	impl := &cffdemoController{}
	w, err := newWrapper(
		p.Dep0,
		p.Dep1,
	)
	if err != nil {
		return nil, err
	}

...

var _ Controller = &cffdemoController{}

// wrapperImpl wraps the Controller methods in the generic decorator.Method type.
type wrapperImpl struct {
	wrapped	Controller

	Create	decorator_rpcshield.Method
	Get	decorator_rpcshield.Method
}

...
```


Another change is in the `GOROOT/src/glue/example.internal/infra/progsys/cff-demo/gluefx/glue_gluefx.go` file.
1. Change the import paths from `"glue/decorator/example.internal/infra/progsys/cff-demo/controller/cff-demo"` to `"example.internal/infra/progsys/cff-demo/controller/cff-demo"`.
2. Change `cffdemo.New` calls to `cffdemo.New_rpcshield`

Contents before:
```
// Code generated by example.internal/glue/generator. DO NOT EDIT.
// @generated

package gluefx

import (
	frameworkgit "example.internal/glue/framework.git"
	decoratorfx "example.internal/glue/framework.git/decorator/decoratorfx"
	scopefx "example.internal/glue/framework.git/scope/scopefx"
	versionfxgit "example.internal/go/versionfx.git"
	cffdemo "glue/decorator/example.internal/infra/progsys/cff-demo/controller/cff-demo"
	lottery "glue/decorator/example.internal/infra/progsys/cff-demo/gateway/lottery"
	__cffdemo "glue/decorator/example.internal/infra/progsys/cff-demo/handler/cff-demo"
	cookie "glue/decorator/example.internal/infra/progsys/cff-demo/repository/cookie"
	fx "go.uber.org/fx"
)

// ServiceModule contains your service's layer constructors.
//
// If you have multiple Glue services in your process, inject
// ALL the ServiceModules and any single FrameworkModule.
var ServiceModule = fx.Options(
	fx.Provide(cffdemo.New),
	fx.Provide(lottery.New),
	fx.Provide(__cffdemo.New),
	fx.Provide(cookie.New),
)

// FrameworkModule contains only Glue's dependencies.
//
// All FrameworkModules generated by the same Glue generator
// binary will be identical.
//
// If you have multiple Glue services in your process, inject
// ALL the ServiceModules and any single FrameworkModule.
var FrameworkModule = fx.Options(
	decoratorfx.Module,
	scopefx.Module,
	fx.Invoke(
		func(r *versionfxgit.Reporter) error { return r.Report("gluefx", frameworkgit.Version) },
	),
)

// Module is an Fx Option containing all of the service's
// layer constructors, and Glue's dependencies, so you only
// need to inject one thing.
//
// Most services should use this.
var Module = fx.Options(
	ServiceModule,
	FrameworkModule,
)
```

Contents after:
```
// Code generated by example.internal/glue/generator. DO NOT EDIT.
// @generated

package gluefx

import (
	frameworkgit "example.internal/glue/framework.git"
	decoratorfx "example.internal/glue/framework.git/decorator/decoratorfx"
	scopefx "example.internal/glue/framework.git/scope/scopefx"
	versionfxgit "example.internal/go/versionfx.git"
	cffdemo "example.internal/infra/progsys/cff-demo/controller/cff-demo"
	lottery "example.internal/infra/progsys/cff-demo/gateway/lottery"
	__cffdemo "example.internal/infra/progsys/cff-demo/handler/cff-demo"
	cookie "example.internal/infra/progsys/cff-demo/repository/cookie"
	fx "go.uber.org/fx"
)

// ServiceModule contains your service's layer constructors.
//
// If you have multiple Glue services in your process, inject
// ALL the ServiceModules and any single FrameworkModule.
var ServiceModule = fx.Options(
	fx.Provide(cffdemo.New_rpcshield),
	fx.Provide(lottery.New_rpcshield),
	fx.Provide(__cffdemo.New_rpcshield),
	fx.Provide(cookie.New_rpcshield),
)

// FrameworkModule contains only Glue's dependencies.
//
// All FrameworkModules generated by the same Glue generator
// binary will be identical.
//
// If you have multiple Glue services in your process, inject
// ALL the ServiceModules and any single FrameworkModule.
var FrameworkModule = fx.Options(
	decoratorfx.Module,
	scopefx.Module,
	fx.Invoke(
		func(r *versionfxgit.Reporter) error { return r.Report("gluefx", frameworkgit.Version) },
	),
)

// Module is an Fx Option containing all of the service's
// layer constructors, and Glue's dependencies, so you only
// need to inject one thing.
//
// Most services should use this.
var Module = fx.Options(
	ServiceModule,
	FrameworkModule,
)
