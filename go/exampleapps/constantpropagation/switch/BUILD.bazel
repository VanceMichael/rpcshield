load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_path")

go_library(
    name = "go_default_library",
    srcs = ["app.go"],
    importpath = "github.com/uber-research/rpcshield/go/exampleapps/constantpropagation/switch",
    visibility = ["//visibility:public"],
)

go_binary(
    name = "switch",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_path(
    name = "switch-anal",
    testonly = True,
    include_data = False,
    visibility = ["//visibility:public"],
    deps = [":switch"],
)
# rpcshield (github.com/uber-research/rpcshield/go) uses this example as test input.
