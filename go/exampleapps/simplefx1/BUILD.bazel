# keep
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_path")

go_library(
    name = "go_default_library",
    srcs = ["app.go"],
    importpath = "github.com/uber-research/rpcshield/go/exampleapps/simplefx1",
    visibility = ["//visibility:private"],
    deps = ["@org_uber_go_fx//:go_default_library"],
)

go_binary(
    name = "simplefx1",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# modelfx uses this example as test input.
go_path(
    name = "simplefx1-anal",
    testonly = True,
    include_data = False,
    visibility = ["//modelfx:__subpackages__"],
    deps = [":simplefx1"],
)
