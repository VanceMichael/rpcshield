# keep
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_path")

go_library(
    name = "go_default_library",
    srcs = ["app.go"],
    importpath = "github.com/uber-research/rpcshield/go/exampleapps/argumentpassing",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "argumentpassing",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# graph/filter_test.go (@rpcshield_ext) uses this example as test input.
go_path(
    name = "argumentpassing-anal",
    testonly = True,
    include_data = False,
    visibility = ["//visibility:public"],
    deps = [":argumentpassing"],
)
