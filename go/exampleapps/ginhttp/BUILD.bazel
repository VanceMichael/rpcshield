# keep
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_path")

go_library(
    name = "go_default_library",
    srcs = ["app.go"],
    importpath = "github.com/uber-research/rpcshield/go/exampleapps/ginhttp",
    visibility = ["//visibility:private"],
    deps = ["@com_github_gin_gonic_gin//:go_default_library"],
)

go_binary(
    name = "ginhttp",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

# rpcshield (github.com/uber-research/rpcshield/go) uses this example as test input.
go_path(
    name = "ginhttp-anal",
    testonly = True,
    include_data = False,
    visibility = ["//finder/http:__subpackages__"],
    deps = [":ginhttp"],
)
