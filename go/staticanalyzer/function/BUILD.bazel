# keep
load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "backprop.go",
        "cfg.go",
        "function.go",
    ],
    importpath = "github.com/uber-research/rpcshield/go/staticanalyzer/function",
    visibility = ["//visibility:public"],
    deps = [
        "//constant:go_default_library",
        "//output:go_default_library",
        "//staticanalyzer/asthelper:go_default_library",
        "@org_golang_x_tools//go/cfg:go_default_library",
        "@org_golang_x_tools//go/types/typeutil:go_default_library",
        "@org_uber_go_zap//:go_default_library",
        "@org_uber_go_zap//zapcore:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    size = "large",
    srcs = [
        "cfg_test.go",
        "function_test.go",
    ],
    data = [
        "//:testdata",
        ":testdata",
        "@go_sdk//:files",
    ],
    embed = [":go_default_library"],
    deps = [
        "//common/pkgdeps:go_default_library",
        "//constant:go_default_library",
        "//loader:go_default_library",
        "//rpcshieldtest:go_default_library",
        "//rta/rtatest:go_default_library",
        "//staticanalyzer/asthelper:go_default_library",
        "@com_github_stretchr_testify//require:go_default_library",
        "@org_golang_x_exp//maps:go_default_library",
        "@org_golang_x_tools//go/analysis:go_default_library",
        "@org_golang_x_tools//go/analysis/analysistest:go_default_library",
        "@org_golang_x_tools//go/analysis/passes/ctrlflow:go_default_library",
        "@org_golang_x_tools//go/cfg:go_default_library",
        "@org_golang_x_tools//go/packages:go_default_library",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
    visibility = ["//visibility:public"],
)
